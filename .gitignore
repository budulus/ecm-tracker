# Virtual environment — never commit (not portable across machines/OSes; recreate with `uv sync`)
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Nuitka build outputs (build.py logs here; *.dist/*.build appear if nuitka is run
# directly without --output-dir; crash report lands at the repo root on failure)
build_log.txt
nuitka-crash-report.xml
*.dist/
*.build/
*.app/

# Exported tracking output
*.npy

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.tmp.*

# Local assistant instructions
/CLAUDE.md
/.claude/
